{
  "name": "menu-qr-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:setup": "prisma db push && prisma generate",
    "build": "tsc",
    "test:sofra": "node tests/theme-settings.test.mjs",
    "test:services": "node tests/service-items.test.mjs",
    "test:image-bg": "node tests/image-background.test.mjs",
    "test:price-history": "node tests/price-history.test.mjs",
    "smtp:check": "node scripts/smtp-check.mjs",
    "test:image-fit": "node tests/image-fit.test.mjs",
    "test:price-series": "node tests/price-series.test.mjs",
    "test:integrations": "node tests/integrations.test.mjs",
    "test:customer-contact": "node tests/customer-contact.test.mjs",
    "test:sofra-config": "node tests/sofra-config.test.mjs",
    "test:contact-card": "node tests/contact-card.test.mjs",
    "test:reviews": "node tests/reviews.test.mjs",
    "test:translations": "node tests/translations.test.mjs && node tests/translations-db.test.mjs",
    "test:login": "node tests/admin-login.test.mjs && node tests/login-mail.test.mjs",
    "test:customer": "node tests/customer-email.test.mjs && node tests/customer-mail.test.mjs",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^10.5.0",
    "prisma": "^6.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}

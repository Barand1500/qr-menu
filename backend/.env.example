DATABASE_URL="mysql://guzelteknoloji-menu-user:bRn241016%21@127.0.0.1:3306/guzelteknoloji-menu-db"
JWT_SECRET="uzun-rastgele-bir-metin-yaz"
PORT=3008
CORS_ORIGIN=https://menu.guzelteknoloji.com,http://menu.guzelteknoloji.com
UPLOAD_DIR=./uploads
PUBLIC_DIR=./public

# Hızlı giriş kodu gönderimi (587 STARTTLS veya 465 TLS).
LOGIN_SMTP_HOST=
LOGIN_SMTP_PORT=587
LOGIN_SMTP_USER=
LOGIN_SMTP_PASSWORD=
LOGIN_MAIL_FROM="Menu QR <giris@example.com>"

# Customer menu account verification (separate from admin LOGIN_SMTP_*).
# Leave empty until SMTP is configured. Existing password sign-in remains available.
CUSTOMER_SMTP_HOST=
CUSTOMER_SMTP_PORT=587
CUSTOMER_SMTP_USER=
CUSTOMER_SMTP_PASSWORD=
CUSTOMER_MAIL_FROM=

# Reserved for future Google OAuth activation. Google remains disabled in this release.
CUSTOMER_GOOGLE_CLIENT_ID=
CUSTOMER_GOOGLE_CLIENT_SECRET=

# Recipe suggestions: shared key 1 is used only during development.
# Production requires a TheMealDB supporter key (the free test key is rejected).
THEMEALDB_API_KEY=

# Free commercial recipe plan: https://www.tinyplates.dev (50/day, 300/week).
# When set, this provider takes priority. Keep the key on the backend only.
TINYPLATES_API_KEY=

# Google yorumları (Places API New). Entegrasyonlar > Google yorumları bu anahtarı kullanır.
# Google Cloud: proje + "Places API (New)" etkin + faturalama. Anahtarı sunucu IP/API ile kısıtlayın.
GOOGLE_PLACES_API_KEY=

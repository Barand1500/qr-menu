generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  staff
}

enum ViewEntityType {
  group
  product
  showcase
  menu
}

model Restaurant {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(100)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users           User[]
  groups          Group[]
  products        Product[]
  showcaseImages  ShowcaseImage[]
  settings        Setting[]
  welcomeMessages WelcomeMessage[]
  viewEvents      ViewEvent[]

  @@map("restaurants")
}

model User {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(150)
  phone        String?  @db.VarChar(30)
  role         UserRole @default(admin)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("users")
}

model Language {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(10)
  name     String  @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  groupTranslations    GroupTranslation[]
  productTranslations  ProductTranslation[]
  welcomeMessages      WelcomeMessage[]

  @@map("languages")
}

/// Menü grupları — ana grup ve alt grup hiyerarşisi
model Group {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  parentId     Int?     @map("ust_grup_id") /// Üst grup (null = ana grup)
  imageUrl     String?  @map("image_url") @db.VarChar(500)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  parent       Group?             @relation("GrupHiyerarsi", fields: [parentId], references: [id], onDelete: Cascade)
  children     Group[]            @relation("GrupHiyerarsi")
  products     Product[]
  translations GroupTranslation[]

  @@index([restaurantId, sortOrder])
  @@index([restaurantId, parentId])
  @@map("groups")
}

/// Grup adı çevirileri (Türkçe, İngilizce vb.)
model GroupTranslation {
  id         Int    @id @default(autoincrement())
  groupId    Int    @map("group_id")
  languageId Int    @map("language_id")
  name       String @db.VarChar(200)

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([groupId, languageId])
  @@map("group_translations")
}

model Product {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  groupId      Int      @map("group_id")
  price        Decimal  @default(0) @db.Decimal(10, 2)
  imageUrl     String?  @map("image_url") @db.VarChar(500)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  group        Group                @relation(fields: [groupId], references: [id], onDelete: Restrict)
  translations ProductTranslation[]

  @@index([restaurantId, groupId, sortOrder])
  @@map("products")
}

model ProductTranslation {
  id          Int     @id @default(autoincrement())
  productId   Int     @map("product_id")
  languageId  Int     @map("language_id")
  name        String  @db.VarChar(200)
  description String? @db.Text

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([productId, languageId])
  @@map("product_translations")
}

model ShowcaseImage {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  name         String   @db.VarChar(200)
  imageUrl     String?  @map("image_url") @db.VarChar(500)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, sortOrder])
  @@map("showcase_images")
}

model WelcomeMessage {
  id           Int    @id @default(autoincrement())
  restaurantId Int    @map("restaurant_id")
  languageId   Int    @map("language_id")
  message      String @db.Text

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  language   Language   @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, languageId])
  @@map("welcome_messages")
}

model Setting {
  id           Int     @id @default(autoincrement())
  restaurantId Int     @map("restaurant_id")
  key          String  @db.VarChar(100)
  value        String? @db.Text

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, key])
  @@map("settings")
}

model ViewEvent {
  id           BigInt         @id @default(autoincrement())
  restaurantId Int            @map("restaurant_id")
  entityType   ViewEntityType @map("entity_type")
  entityId     Int            @map("entity_id")
  sessionId    String         @map("session_id") @db.VarChar(64)
  viewedAt     DateTime       @default(now()) @map("viewed_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, entityType, viewedAt])
  @@index([restaurantId, sessionId, viewedAt])
  @@map("view_events")
}
